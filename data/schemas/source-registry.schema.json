{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://islamicknowledge.example.com/schemas/source-registry.schema.json",
  "title": "Source Registry Schema",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "string" },
    "lastUpdated": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "sourceType",
          "url",
          "licenseStatus",
          "attributionRequired",
          "redistributionPermitted"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[0-9]{3}$" },
          "title": { "type": "string" },
          "provider": { "type": "string" },
          "author": { "type": "string" },
          "category": { "type": "string" },
          "sourceType": { "type": "string", "enum": ["primary", "secondary", "tertiary"] },
          "url": { "type": "string" },
          "edition": { "type": "string" },
          "publisher": { "type": "string" },
          "licenseStatus": { "type": "string", "enum": ["VERIFIED_PERMISSION", "PERMISSION_REQUIRES_REVIEW", "LICENSE_UNKNOWN", "NOT_PERMITTED"] },
          "licenseName": { "type": "string" },
          "attributionRequired": { "type": "boolean" },
          "attributionText": { "type": "string" },
          "redistributionPermitted": { "type": "boolean" },
          "offlineApkBundlingPermitted": { "type": "boolean" },
          "audioStreamingPermitted": { "type": "string" },
          "verificationDate": { "type": "string" },
          "reviewNotes": { "type": "string" }
        }
      }
    }
  }
}