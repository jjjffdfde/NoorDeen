{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://islamicknowledge.example.com/schemas/history-era.schema.json",
  "title": "History Era Schema",
  "type": "object",
  "required": [
    "id",
    "eraNumber",
    "title",
    "periodCe",
    "periodAh",
    "geographicScope",
    "majorDynasties",
    "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^history-era-[0-9]{2}$" },
    "eraNumber": { "type": "integer", "minimum": 1, "maximum": 20 },
    "title": { "type": "string" },
    "arabicTitle": { "type": "string" },
    "periodCe": { "type": "string" },
    "periodAh": { "type": "string" },
    "geographicScope": { "type": "string" },
    "capitalCities": { "type": "array", "items": { "type": "string" } },
    "majorDynasties": { "type": "array", "items": { "type": "string" } },
    "keyRulers": { "type": "array", "items": { "type": "string" } },
    "intellectualMilestones": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1 }
  }
}