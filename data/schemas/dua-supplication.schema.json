{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://islamicknowledge.example.com/schemas/dua-supplication.schema.json",
  "title": "Dua & Supplication Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "arabicText",
    "transliteration",
    "translations",
    "sourceCitation",
    "virtueAndContext"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^dua-[a-z0-9-]+$" },
    "title": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "morning_evening",
        "salah_devotion",
        "janazah_funeral",
        "eid_celebration",
        "protection_anxiety",
        "home_travel",
        "food_drink",
        "repentance_forgiveness",
        "quranic_rabbana"
      ]
    },
    "arabicText": { "type": "string" },
    "transliteration": { "type": "string" },
    "translations": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "ur": { "type": "string" }
      }
    },
    "sourceCitation": { "type": "string" },
    "canonicalHadithReference": { "type": "string" },
    "recitationCount": { "type": "string", "default": "1x" },
    "recommendedTiming": { "type": "string" },
    "virtueAndContext": { "type": "string" }
  }
}