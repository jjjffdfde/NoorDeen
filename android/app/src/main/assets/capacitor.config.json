{
	"appId": "com.islamicknowledge.portal",
	"appName": "NoorDeen",
	"webDir": "public",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#176B5B",
			"androidSplashResourceName": "splash",
			"showSpinner": false
		}
	}
}
