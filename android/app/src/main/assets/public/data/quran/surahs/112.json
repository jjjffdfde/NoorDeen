{"number":112,"name":"الإِخْلَاص","englishName":"Al-Ikhlas","englishNameTranslation":"The Sincerity","revelationType":"Meccan","numberOfAyahs":4,"juzStart":30,"bismillahPre":true,"ayahs":[{"num":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","ur":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","tr":"Qul huwal laahu ahad","juz":30,"page":604},{"num":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","ur":"معبود برحق جو بےنیاز ہے","tr":"Allah hus-samad","juz":30,"page":604},{"num":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","ur":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","tr":"Lam yalid wa lam yoolad","juz":30,"page":604},{"num":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","ur":"اور کوئی اس کا ہمسر نہیں","tr":"Wa lam yakul-lahu kufuwan ahad","juz":30,"page":604}]}