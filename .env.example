# Islamic Knowledge Portal - Environment Configuration
# Copy this file to .env.local to customize your environment

# Application URL (for canonical SEO URLs and sitemaps)
NEXT_PUBLIC_SITE_URL=https://islamicknowledge.example.com

# Quran API configuration (Optional: defaults to public Tanzil & Quran Cloud API)
NEXT_PUBLIC_QURAN_API_URL=https://api.alquran.cloud/v1

# AdSense Configuration (Keep disabled until approved by Google AdSense)
# Set to 'true' only when approved and active
NEXT_PUBLIC_ENABLE_ADSENSE=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Analytics (Optional, privacy-preserving)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
